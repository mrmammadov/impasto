{
  "name": "loose-brush",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repaints any picture as a loose oil sketch, stroke by stroke, in the browser.",
  "scripts": {
    "dev": "npx --yes serve . -l 5173",
    "build": "node build.mjs",
